{
  "name": "@acentric/runner-memory",
  "version": "0.1.0",
  "description": "A runner that keeps everything in memory: for tests, scripts and trying agents out.",
  "license": "Apache-2.0",
  "homepage": "https://docs.acentric.dev",
  "bugs": {
    "url": "https://github.com/acentricai/acentric/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acentricai/acentric.git",
    "directory": "runners/memory"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@acentric/replay": "workspace:*",
    "@acentric/types": "workspace:*"
  },
  "devDependencies": {
    "@acentric/conformance": "workspace:*"
  }
}
