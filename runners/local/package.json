{
  "name": "@acentric/runner-local",
  "version": "0.1.0",
  "description": "A runner for your own machine: keeps instances in a store across restarts and runs handlers in child processes.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@acentric/types": "workspace:*"
  },
  "devDependencies": {
    "@acentric/conformance": "workspace:*",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2"
  }
}
