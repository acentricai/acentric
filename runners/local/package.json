{
  "name": "@acentric/runner-local",
  "version": "0.1.1",
  "description": "A runner for your own machine: keeps sessions in a store across restarts and runs handlers in child processes.",
  "keywords": [
    "acentric",
    "ai",
    "agent",
    "agents",
    "reducer",
    "effects",
    "runner",
    "sqlite",
    "durable"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/acentricai/acentric/tree/main/runners/local#readme",
  "bugs": {
    "url": "https://github.com/acentricai/acentric/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acentricai/acentric.git",
    "directory": "runners/local"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "acentric-runner": "./dist/server/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@acentric/protocol": "workspace:*",
    "@acentric/replay": "workspace:*",
    "@acentric/types": "workspace:*",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@acentric/client": "workspace:*",
    "@acentric/conformance": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2"
  }
}
