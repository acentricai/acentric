{
  "name": "@acentric/example-pi",
  "version": "0.1.0",
  "private": true,
  "description": "pi's original coding agent, rebuilt as an acentric agent.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers/index.d.ts",
      "default": "./dist/handlers/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@acentric/types": "workspace:*",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@acentric/cli": "workspace:*",
    "@acentric/testing": "workspace:*",
    "@types/node": "^26.6.5"
  }
}
