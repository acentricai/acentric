# Caddy on the same machine, in front of the server: it gets and renews the HTTPS certificate
# for the name in the first line, which must point at this machine, with ports 80 and 443 open.
engine.example.com {
	reverse_proxy 127.0.0.1:4000 {
		# Actors' events are sent as they come; machines' WebSockets pass and stay open.
		flush_interval -1
	}
}
