# What the server is run with: /etc/acentric/acentric.env, readable by root alone.

# The version of the server, for acentric.service (Docker). acentric.container (Podman) names
# its version in the file itself.
ACENTRIC_VERSION=0.15.0

# Where people, the acentric command and machines reach the server: the HTTPS address of the
# proxy in front of it.
ACENTRIC_PUBLIC_URL=https://engine.example.com

# What agents' secrets and the keys of model accounts are sealed with: 64 hex characters, made
# once with `openssl rand -hex 32`. Keep a copy somewhere other than this machine.
ACENTRIC_SECRET_KEY=

# An API key that may do everything, of 24 characters or more, such as `openssl rand -hex 24`.
# Without it, the server makes one when it first starts, in /data/first-admin-key.
ACENTRIC_ADMIN_KEY=

# Where the server's own backups go, every day and before an upgrade: the volume
# acentric-backups. How often (24h, 6h, 30m, 7d, or off), and how many of each kind are kept.
ACENTRIC_BACKUP_DIR=/backups
# ACENTRIC_BACKUP_EVERY=24h
# ACENTRIC_BACKUP_KEEP=3

# A bucket each backup is copied to as well, off this machine, at S3 or at a store that speaks
# its API at AWS_ENDPOINT_URL_S3; and a key that may put, list, read and remove there, unless
# this is an EC2 instance whose role may. See BACKUPS.md.
# ACENTRIC_BACKUP_URL=s3://my-bucket/acentric
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
