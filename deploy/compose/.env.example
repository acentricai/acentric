# What the server is run with. Copy to .env, which is kept on this machine and nowhere else.

# The version of the server, as VERSIONS.md says: an exact one, changed on purpose.
ACENTRIC_VERSION=0.15.0

# Where people, the acentric command and machines reach the server. Its name must point at this
# machine, for Caddy to get its certificate.
ACENTRIC_PUBLIC_URL=https://engine.example.com

# The keys are not here: they are files of secrets/, beside this one (see README.md).

# How often the server backs itself up (24h, 6h, 30m, 7d, or off), and how many it keeps of
# each kind. One is taken before a new version changes the database too.
# ACENTRIC_BACKUP_EVERY=24h
# ACENTRIC_BACKUP_KEEP=3

# A bucket each backup is copied to as well, off this machine: what is left when it is lost. At
# S3, or at a store that speaks its API (R2, B2, MinIO, …) at AWS_ENDPOINT_URL_S3. The key is
# one that may put, list, read and remove in that bucket only. On an EC2 instance with a role
# that may, leave the key out.
# ACENTRIC_BACKUP_URL=s3://my-bucket/acentric
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://<account>.r2.cloudflarestorage.com

# The server's log as JSON, one object to a line, for what collects it; and its metrics, for
# Prometheus, at http://server:9464/metrics on the Compose network only.
# ACENTRIC_LOG_FORMAT=json
# ACENTRIC_METRICS_PORT=9464

# How long archived actors (with their conversations), the audit log and what calls of models
# cost are kept, such as 90d: for ever, without them. See DATA.md.
# ACENTRIC_RETAIN_ARCHIVED=90d
# ACENTRIC_RETAIN_AUDIT=365d
# ACENTRIC_RETAIN_USAGE=400d

# The ports Caddy listens on, when 80 and 443 are taken. Another HTTPS port is then in
# ACENTRIC_PUBLIC_URL too, such as https://engine.example.com:8443, and people use that address:
# plain HTTP is sent to port 443.
# ACENTRIC_HTTP_PORT=80
# ACENTRIC_HTTPS_PORT=443
