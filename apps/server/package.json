{
  "name": "@acentric/server",
  "version": "0.15.0",
  "private": true,
  "description": "The Acentric server: the API, sign-in, and the engine that runs actors.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acentricai/acentric.git",
    "directory": "apps/server"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "acentric-server": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@acentric/ai": "workspace:*",
    "@acentric/core": "workspace:*",
    "@acentric/executor": "workspace:*",
    "@acentric/sandbox": "workspace:*",
    "@acentric/protocol": "workspace:*",
    "@acentric/store": "workspace:*",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "ws": "8.22.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acentric/client": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.2"
  }
}
