# Served by Cloudflare with every file: the docs are a Worker serving the
# build as static assets (wrangler.jsonc). The docs load nothing from
# elsewhere: scripts, styles and fonts are this origin's, and search runs in
# the page. The exception is Cloudflare Web Analytics, which the zone injects:
# its beacon script, and where it reports page views (cookieless).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite names built assets by their content, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
