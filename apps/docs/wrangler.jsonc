// The docs at https://docs.acentric.dev: a Worker that serves the build's
// static files, nothing else. `pnpm --filter @acentric/docs release` builds and
// publishes it. Each page is its own index.html, a path that matches nothing
// gets 404.html, and every response gets the headers in public/_headers.
{
  "$schema": "https://unpkg.com/wrangler@4.83.0/config-schema.json",
  "name": "acentric-docs",
  // The Cloudflare account that holds acentric.dev, as acentric-cloud's deploys use.
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Cloudflare creates the DNS record and the certificate for the custom domain.
  "routes": [{ "pattern": "docs.acentric.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
