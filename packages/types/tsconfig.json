{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // AbortSignal, used by HandlerContext, is declared by the DOM library.
    // Node, Bun, Deno and browsers all provide it at runtime.
    "lib": ["ES2023", "DOM"],
