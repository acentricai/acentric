{
  "name": "A finished key never runs again",
  "section": "7",
  "steps": [
    {
      "create": {}
    },
    {
      "input": "declare",
      "payload": {
        "effects": [
          {
            "key": "a",
            "kind": "echo",
            "args": {
              "value": 1
            }
          }
        ]
      }
    },
    {
      "expect": {
        "log": [
