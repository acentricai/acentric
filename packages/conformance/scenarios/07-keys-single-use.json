                "ok": 1
              }
            }
          }
        ]
      }
    },
    {
      "input": "declare",
      "payload": {
        "effects": [
          {
            "key": "a",
            "kind": "echo",
            "args": {
              "value": 2
            }
          }
        ]
      }
    },
    {
      "expect": {
        "running": [],
        "logKinds": ["init", "input", "result", "input"]
      }
    }
  ]
