  "private": true,
  "description": "The engine as a library: the turn machine, mailbox, tasks, compaction and scheduler, built on interfaces alone.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acentricai/acentric.git",
    "directory": "packages/core"
  },
