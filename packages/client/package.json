{
  "name": "@acentric/client",
  "version": "0.1.0",
  "description": "Talk to an acentric runner from an application: over WebSocket, or by starting one over stdio.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@acentric/protocol": "workspace:*",
    "@acentric/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
