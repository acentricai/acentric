{
  "name": "@acentric/protocol",
  "version": "0.1.1",
  "description": "The protocol between applications and acentric runners: JSON-RPC methods, notifications and a peer to speak them.",
  "keywords": [
    "acentric",
    "ai",
    "agent",
    "agents",
    "reducer",
    "effects",
    "protocol",
    "json-rpc"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/acentricai/acentric/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/acentricai/acentric/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acentricai/acentric.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@acentric/types": "workspace:*"
  }
}
