{
  "name": "@acentric/protocol",
  "version": "0.15.0-alpha.0",
  "description": "The contracts every part of Acentric is built against: API schemas, events, the bundle manifest and protocol versions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acentricai/acentric.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "default": "./dist/bundle.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
