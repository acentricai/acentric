{
  "name": "@acentric/testing",
  "version": "0.1.1",
  "description": "Runs an agent's pure half in memory, for tests: no runner, no handlers, no I/O.",
  "keywords": [
    "acentric",
    "ai",
    "agent",
    "agents",
    "reducer",
    "effects",
    "testing",
    "simulation"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/acentricai/acentric/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/acentricai/acentric/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acentricai/acentric.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@acentric/replay": "workspace:*",
    "@acentric/types": "workspace:*"
  }
}
